{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "project",
    "target",
    "statuses",
    "subsystems",
    "apis",
    "drivers",
    "binaries",
    "milestones",
    "known_limitations",
    "changelog"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "project": {
      "type": "object",
      "required": [
        "name",
        "repository",
        "description",
        "stage",
        "architecture"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "stage": {
          "type": "string",
          "minLength": 1
        },
        "architecture": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "target": {
      "type": "object",
      "required": [
        "version",
        "release",
        "edition",
        "build",
        "revision",
        "architecture",
        "acquisition",
        "source"
      ],
      "additionalProperties": false,
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "release": {
          "type": "string",
          "minLength": 1
        },
        "edition": {
          "type": "string",
          "minLength": 1
        },
        "architecture": {
          "type": "string",
          "minLength": 1
        },
        "acquisition": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "build": {
          "type": "integer",
          "minimum": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "statuses": {
      "const": [
        "UNKNOWN",
        "RESEARCH",
        "DESIGN",
        "STUB",
        "PARTIAL",
        "IMPLEMENTED",
        "VALIDATED",
        "REGRESSION_TESTED",
        "BROKEN"
      ]
    },
    "subsystems": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/subsystem"
      }
    },
    "apis": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/api"
      }
    },
    "drivers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/driver"
      }
    },
    "binaries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/binary"
      }
    },
    "milestones": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "status",
          "deliverables"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "enum": [
              "UNKNOWN",
              "RESEARCH",
              "DESIGN",
              "STUB",
              "PARTIAL",
              "IMPLEMENTED",
              "VALIDATED",
              "REGRESSION_TESTED",
              "BROKEN"
            ]
          },
          "deliverables": {
            "type": "string"
          }
        }
      }
    },
    "known_limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "changelog": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "version",
          "date",
          "changes"
        ],
        "properties": {
          "version": {
            "type": "string"
          },
          "date": {
            "type": "string"
          },
          "changes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "commit": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      ]
    },
    "subsystem": {
      "type": "object",
      "required": [
        "id",
        "name",
        "status",
        "notes",
        "evidence",
        "last_validated_commit"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "status": {
          "enum": [
            "UNKNOWN",
            "RESEARCH",
            "DESIGN",
            "STUB",
            "PARTIAL",
            "IMPLEMENTED",
            "VALIDATED",
            "REGRESSION_TESTED",
            "BROKEN"
          ]
        },
        "notes": {
          "type": "string"
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "last_validated_commit": {
          "$ref": "#/$defs/commit"
        }
      }
    },
    "api": {
      "type": "object",
      "required": [
        "name",
        "prototype",
        "subsystem",
        "status",
        "irql",
        "blocking",
        "notes",
        "source",
        "tests",
        "known_callers",
        "last_validated_commit"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "prototype": {
          "type": "string",
          "minLength": 1
        },
        "subsystem": {
          "type": "string",
          "minLength": 1
        },
        "irql": {
          "type": "string",
          "minLength": 1
        },
        "blocking": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "UNKNOWN",
            "RESEARCH",
            "DESIGN",
            "STUB",
            "PARTIAL",
            "IMPLEMENTED",
            "VALIDATED",
            "REGRESSION_TESTED",
            "BROKEN"
          ]
        },
        "tests": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "known_callers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "last_validated_commit": {
          "$ref": "#/$defs/commit"
        }
      }
    },
    "driver": {
      "type": "object",
      "required": [
        "name",
        "vendor",
        "version",
        "sha256",
        "windows_build",
        "load_result",
        "driver_entry_result",
        "runtime_status",
        "failure_reason",
        "last_tested_commit"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "vendor": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "windows_build": {
          "type": "string"
        },
        "load_result": {
          "type": "string"
        },
        "driver_entry_result": {
          "type": "string"
        },
        "runtime_status": {
          "type": "string"
        },
        "failure_reason": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "last_tested_commit": {
          "$ref": "#/$defs/commit"
        }
      }
    },
    "binary": {
      "type": "object",
      "required": [
        "name",
        "version",
        "sha256",
        "windows_build"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "windows_build": {
          "type": "string"
        }
      }
    }
  }
}
